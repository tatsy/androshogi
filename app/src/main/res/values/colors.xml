<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#ff000000</color>
    <color name="white">#ffffffff</color>

    <!-- 盤まわり。木目と駒はテーマに関係なく同じ見え方にする -->
    <color name="board_background">#ffeeb887</color>
    <color name="cell_selected_piece">#55ff0000</color>
    <color name="cell_legal_moves">#88ff0000</color>
    <color name="cell_last_move">#55ff0000</color>
    <color name="circle_n_hand_pieces">#ff333333</color>
    <!-- 棋譜の次の一手を示す矢印。読み筋の赤い矢印と区別できる青にする -->
    <color name="arrow_next_move">#b31565c0</color>
    <!-- 分岐点の未選択の継続手。選択中の青・読み筋の赤と区別する -->
    <color name="arrow_variation_move">#99007850</color>

    <!-- 面の上に線や文字として置くアクセント。テーマの colorPrimary は塗りつぶした
         ボタンの背景として使う想定の濃さで、ダークでは前景にするとコントラストが足りない。
         ダークの値は values-night/colors.xml -->
    <color name="accent_on_surface">#ff6750a4</color>
    <!-- 勝率グラフの塗り。accent_on_surface に不透明度を付けたもの -->
    <color name="win_rate_fill">#406750a4</color>

    <!-- テーマ色。ライトは Material3 の基準色に合わせ、ダークは木目の盤と喧嘩しない落ち着いた藍鼠にする -->
    <color name="theme_light_primary">#ff6750a4</color>
    <color name="theme_light_on_primary">#ffffffff</color>
    <color name="theme_dark_primary">#ff4f5b93</color>
    <color name="theme_dark_on_primary">#ffffffff</color>
</resources>
